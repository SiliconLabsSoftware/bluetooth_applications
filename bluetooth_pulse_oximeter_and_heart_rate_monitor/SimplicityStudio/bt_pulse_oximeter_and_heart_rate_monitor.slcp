project_name: bt_pulse_oximeter_and_heart_rate_monitor
package: Bluetooth
label: Bluetooth - Pulse Oximeter and Heart Rate Monitor (MAX30101 & MAX32664)
description: >
  This project aims to implement a pulse oximeter and heart rate monitor and notification system using Silabs development kits and external sensors integrated with the BLE wireless stack.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]

include:
  - path: ../inc
    file_list:
      - path: app.h
      - path: display_and_sound.h
      - path: pulse_oximeter_and_heart_rate_monitor.h

source:
  - path: ../src/app.c
  - path: ../src/display_and_sound.c
  - path: ../src/pulse_oximeter_and_heart_rate_monitor.c

component:
  - id: app_assert
  - id: app_log
  - id: app_os_helper
  - id: gatt_configuration
  - id: gatt_service_device_information_override
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_nvm
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_system
  - id: bluetooth_stack
  - id: clock_manager
  - id: device_init
  - id: emlib_iadc
  - id: emlib_letimer
  - id: in_place_ota_dfu
  - id: mpu
  - id: rail_util_pti
  - id: sl_main
  - id: bt_post_build
  - id: i2cspm
    instance: [qwiic]
  - id: iostream_eusart
    instance: [vcom]
  - id: mikroe_buzz2
    from: third_party_hw_drivers
  - id: services_oled_glib
    from: third_party_hw_drivers
  - id: sparkfun_hr_po_max30101_max32664
    from: third_party_hw_drivers
  - id: sparkfun_micro_oled_ssd1306
    from: third_party_hw_drivers

sdk_extension:
  - id: third_party_hw_drivers
    version: 4.4.0

configuration:
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

define:
  - name: DEBUG_EFM

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: "../config/btconf/gatt_configuration.btconf"
    directory: "btconf"

post_build:
  - profile: bt_common

readme:
  - path: ../README.md

other_file:
  - path: ../image/alarm_actived.png
    directory: image
  - path: ../image/create_project.png
    directory: image
  - path: ../image/hardware_connection.png
    directory: image
  - path: ../image/log.png
    directory: image  
  - path: ../image/no_finger_detected.png
    directory: image
  - path: ../image/notify.png
    directory: image   
  - path: ../image/release_pressure.png
    directory: image 
  - path: ../image/sensor.png
    directory: image
  - path: ../image/setting.png
    directory: image
  - path: ../image/sw_alarm_flow.png
    directory: image
  - path: ../image/sw_init.png
    directory: image
  - path: ../image/sw_layer.png
    directory: image
  - path: ../image/sw_main_flow.png
    directory: image

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: README.md
      focus: true
